# Used by the Prisma CLI (migrate, studio, seed). Copy to .env. Same values as apps/api/.env.
# DATABASE_URL is the pooled Neon URL; DIRECT_DATABASE_URL is the direct URL used for migrations.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/primestar_hrms?sslmode=require&connect_timeout=15
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/primestar_hrms?sslmode=require&connect_timeout=15

# First CEO account, created by `pnpm db:seed` (never commit real values). Everyone else is created by the CEO
# in Users & Roles. The password must have 8+ characters with upper, lower, a number and a special character.
SEED_CEO_EMAIL=ceo@primestar.test
SEED_CEO_NAME=Rajesh Sharma
SEED_CEO_PASSWORD=
# Set to true to overwrite the password of an existing CEO account.
SEED_CEO_RESET_PASSWORD=false

# Development only: one active account per role (ceo@, hr.head@, hr@, finance@, po.admin@, pm@, employee@primestar.test),
# all with this password. Refused when NODE_ENV=production. Replaces the single-CEO seed above while it is on.
SEED_DEV_USERS=false
SEED_DEV_PASSWORD=
