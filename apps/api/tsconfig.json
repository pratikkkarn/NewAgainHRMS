{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    "noUncheckedIndexedAccess": true,
    "declaration": false,
    "outDir": "dist",
    "baseUrl": ".",
    "customConditions": [
      "@primestar/source"
    ]
  },
  "include": [
    "src",
    "vitest.config.ts"
  ]
}
