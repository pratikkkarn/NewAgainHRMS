# Copy to .env for local development. Production values live in Render env vars.
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
# Proxies in front of the API: 1 for Render alone, 2 behind the Vercel /api rewrite (Vercel, then Render).
TRUST_PROXY_HOPS=1

# Neon PostgreSQL. Use the `dev` branch locally and the `main` branch in production.
# DATABASE_URL is the pooled URL (host has -pooler). DIRECT_DATABASE_URL is the direct URL, used for migrations.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/primestar_hrms?sslmode=require&connect_timeout=15
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/primestar_hrms?sslmode=require&connect_timeout=15

# Generate each with: openssl rand -base64 48 (different values per environment)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
# AES-256-GCM key for Aadhaar/PAN, 32 bytes base64. Generate with: openssl rand -base64 32
# Never change it in production once data exists, or encrypted fields can't be read.
FIELD_ENCRYPTION_KEY=

# Cloudinary: Console > Settings > API Keys. Files are uploaded as private (type=authenticated).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=primestar-hrms/dev

# Worker runs inside the API on Render's free tier. Set false once it is its own service.
RUN_WORKER=true

# Brevo (used by the in-process worker): Settings > SMTP & API > API Keys.
# Leave BREVO_API_KEY empty locally to log emails instead of sending. MAIL_FROM must be a verified Brevo sender.
BREVO_API_KEY=
MAIL_FROM=no-reply@primestar.example
MAIL_FROM_NAME=Prime Star HRMS

# Secret for POST /api/jobs/daily-alerts (GitHub Actions, 09:00 IST). Generate with: openssl rand -hex 32
JOB_TRIGGER_SECRET=

SENTRY_DSN=
