# Copy to .env for local development. Production values live in Render env vars.
NODE_ENV=development

# pg-boss needs a session connection, so use the direct (non-pooled) Neon URL here.
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/primestar_hrms?sslmode=require&connect_timeout=15

# Brevo transactional email: Settings > SMTP & API > API Keys. Leave empty locally to log emails instead of sending.
# MAIL_FROM must be a sender verified in Brevo (Senders, Domains & Dedicated IPs).
BREVO_API_KEY=
MAIL_FROM=no-reply@primestar.example
MAIL_FROM_NAME=Prime Star HRMS

# Cloudinary, for invoice PDFs. Same account as the API.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=primestar-hrms/dev

SENTRY_DSN=
