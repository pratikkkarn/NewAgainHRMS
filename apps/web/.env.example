# Only needed if the API runs somewhere other than http://localhost:4000
# API_URL=http://localhost:4000

# Quick sign-in by role on the login page, for development and test deployments. It needs both of these:
#   VITE_QUICK_LOGIN=true   (not needed in `vite dev`, where it is always on)
#   VITE_DEV_PASSWORD=<the shared password of the seeded role accounts>
# Locally put them in apps/web/.env.local (gitignored). In Vercel put them in the project's Environment Variables
# (Production). The password is written into the built JavaScript, so use it only for test accounts.
# VITE_QUICK_LOGIN=
# VITE_DEV_PASSWORD=
# Set to false to run the whole app on sample data, with no backend.
# VITE_USE_API=true
